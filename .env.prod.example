COMPOSE_PROJECT_NAME=gym-prod

POSTGRES_DB=gym
POSTGRES_USER=gym
POSTGRES_PASSWORD=change-me

FRONTEND_PORT=80

SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/gym
SPRING_DATASOURCE_USERNAME=gym
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_PROFILES_ACTIVE=prod
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false
API_SECURITY_TOKEN_SECRET=change-me
CORS_ALLOWED_ORIGINS=https://seu-dominio.com
AUTH_COOKIE_NAME=gym_auth
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_MAX_AGE_SECONDS=7200
CSRF_COOKIE_SECURE=true
CSRF_COOKIE_SAME_SITE=Lax

VITE_API_URL=/api
